---
import { IconArrowUp } from "@tabler/icons-react";
---

<a
	data-scroll-top
	href="#"
	aria-label="Back to top"
	class="pointer-events-none fixed right-6 bottom-6 z-40 inline-flex size-12 translate-y-2 items-center justify-center border border-border bg-background/90 text-foreground opacity-0 shadow-sm backdrop-blur transition-all duration-300 ease-out hover:bg-muted hover:text-primary data-[visible]:pointer-events-auto data-[visible]:translate-y-0 data-[visible]:opacity-100"
>
	<IconArrowUp size={20} stroke={1.5} aria-hidden="true" />
</a>
