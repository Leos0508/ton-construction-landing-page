---
import { Image } from "astro:assets";
import { IconLoader2, IconX } from "@tabler/icons-react";
import type { Project } from "@/data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<dialog
	id={`project-${project.id}`}
	class="m-auto w-[min(92vw,44rem)] max-h-[90vh] overflow-y-auto border border-border bg-background p-0 text-foreground backdrop:bg-neutral-950/60 backdrop:backdrop-blur-md"
>
	<div class="flex flex-col">
		<div data-image class="relative">
			<Image
				src={project.image}
				alt={project.alt}
				widths={[600, 1200]}
				sizes="(min-width: 768px) 44rem, 92vw"
				class="aspect-[16/10] w-full object-cover"
			/>
			<div
				data-image-spinner
				class="absolute inset-0 grid place-items-center bg-muted transition-opacity duration-300 data-[loaded]:opacity-0"
			>
				<IconLoader2
					className="animate-spin text-muted-foreground"
					size={24}
					stroke={1.5}
					aria-hidden="true"
				/>
			</div>
		</div>

		<div class="flex flex-col gap-4 p-6">
			<div class="flex items-start justify-between gap-6">
				<div class="flex flex-col gap-1">
					<p class="text-xs tracking-widest text-muted-foreground uppercase">
						{project.category} · {project.year}
					</p>
					<h3 class="font-heading text-3xl leading-none">{project.name}</h3>
				</div>
				<button
					type="button"
					data-project-close
					aria-label="Close project"
					class="inline-flex size-9 shrink-0 items-center justify-center border border-border transition-colors hover:bg-muted"
				>
					<IconX size={18} stroke={1.5} aria-hidden="true" />
				</button>
			</div>

			<p class="text-sm text-muted-foreground">{project.location}</p>
			<p class="text-sm">{project.description}</p>
		</div>
	</div>
</dialog>
