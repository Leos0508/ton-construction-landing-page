---
import Layout from "@/layouts/main.astro";
import { StyledButton } from "@/components/StyledButton";
import { IconArrowUpRight } from "@tabler/icons-react";
import { LogoInverted } from "@/components/Logo";
import { Image } from "astro:assets";
import heroImage from "@/assets/hero.webp";
import aboutImage1 from "@/assets/about-1.webp";
import aboutImage2 from "@/assets/about-2.webp";
import { featuredProjects } from "@/data/projects";

const stats = [
  { value: "18+", label: "Years of Experience" },
  { value: "120+", label: "Projects Completed" },
  { value: "85+", label: "Industry Professionals" },
  { value: "12", label: "Provinces Served" },
];

const contact = [
  {
    title: "Office Address",
    lines: [
      "128 Nguyen Van Linh",
      "Boulevard, Tan Phong Ward",
      "District 7, Ho Chi Minh City, Vietnam",
    ],
    map: "https://maps.google.com/maps?q=128%20Nguyen%20Van%20Linh%20Boulevard%2C%20Tan%20Phong%20Ward%2C%20District%207%2C%20Ho%20Chi%20Minh%20City%2C%20Vietnam&z=15&output=embed",
  },
  {
    title: "Phone",
    lines: ["+84 28 7300 8520"],
  },
  {
    title: "Social Medias",
    lines: ["Facebook", "Instagram", "LinkedIn"],
  },
];
---

<Layout
  title="TON Construction Group"
  description="Placeholder landing page built with Astro, Tailwind CSS, and shadcn/ui."
>
  <!-- Hero -->
  <section
    data-hero
    class="group relative mt-20 flex min-h-[calc(100vh-5rem)] flex-col items-center overflow-hidden px-6 pt-16 pb-16 text-center"
  >
    <Image
      src={heroImage}
      alt=""
      widths={[640, 960, 1280, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div
      class="absolute inset-0 bg-neutral-950/45 transition-colors duration-700 ease-out group-hover:bg-neutral-950/25"
      aria-hidden="true"
    ></div>

    <h1 class="relative z-10 font-heading max-w-3xl text-4xl leading-none tracking-tight text-white sm:text-6xl">
      We build what last
    </h1>

    <div
      class="hero-line relative z-10 my-8 w-px flex-1 bg-white/40"
      aria-hidden="true"
    ></div>

    <div class="hero-copy relative z-10 flex max-w-xl flex-col items-center gap-6">
      <p class="text-sm text-white/80">
        From concept to completion, we deliver reliable construction solutions
        through quality, innovation, and a commitment to excellence. We turn
        ambitious ideas into enduring structures.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <StyledButton
          href="#projects"
          variant="outline"
          className="border-white/60 bg-transparent text-white hover:bg-white/10 hover:text-white"
        >
          Explore our projects
        </StyledButton>
        <StyledButton
          href="#contact"
          className="bg-white text-neutral-900 hover:bg-white/90"
        >
          Get in touch
          <IconArrowUpRight size={20} stroke={1.5} aria-hidden="true" />
        </StyledButton>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section>
    <div class="mx-auto grid w-full max-w-[1200px] grid-cols-2 gap-y-8 px-6 py-12 sm:grid-cols-4">
      {stats.map((stat) => (
        <div class="px-2 sm:px-4">
          <p class="font-heading text-4xl leading-none">{stat.value}</p>
          <p class="mt-2 text-sm text-muted-foreground">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- About, text left / image right -->
  <section
    id="about"
    class="mx-auto grid w-full max-w-[1200px] scroll-mt-20 items-start gap-10 px-6 py-20 lg:grid-cols-2 lg:gap-16"
  >
    <div class="flex flex-col gap-6" data-reveal>
      <h2 class="font-heading text-4xl leading-none">About us</h2>
      <p class="text-2xl font-medium">
        Built on <span class="font-display italic">Experience</span>. Driven by{" "}
        <span class="font-display italic">Excellence</span>.
      </p>
      <p class="text-sm font-light">
        At TON, we believe every great structure begins with a strong
        foundation, not just in materials, but in trust, expertise, and
        collaboration.
      </p>
      <p class="text-sm font-light">
        We are a construction and development company specializing in
        residential, commercial, and industrial projects.
      </p>
    </div>

    <Image
      src={aboutImage1}
      alt="Three engineers in high-visibility vests reviewing a set of plans on site"
      widths={[400, 794]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      class="aspect-[16/10] w-full object-cover"
    />
  </section>

  <!-- About, image left / text right -->
  <section class="mx-auto grid w-full max-w-[1200px] items-stretch gap-10 px-6 pb-20 lg:grid-cols-2 lg:gap-16">
    <Image
      src={aboutImage2}
      alt="Construction team in hard hats inspecting the concrete frame of a project"
      widths={[470, 939]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      class="aspect-[16/10] w-full object-cover"
    />

    <div class="flex flex-col justify-between gap-8" data-reveal>
      <div class="flex flex-col gap-6">
        <p class="text-sm font-light">
          Our team combines technical expertise with practical experience to
          deliver projects that meet the highest standards of quality, safety,
          and performance.
        </p>
        <p class="text-sm font-light">
          From the initial planning stages to the final handover, we approach
          every project with precision, transparency, and a commitment to
          getting things right.
        </p>
      </div>
      <div class="flex justify-end">
        <StyledButton href="#" variant="outline">
          Discover our story
          <IconArrowUpRight size={20} stroke={1.5} aria-hidden="true" />
        </StyledButton>
      </div>
    </div>
  </section>

  <!-- Featured projects -->
  <section id="projects" class="scroll-mt-20 border-t border-border">
    <div class="mx-auto w-full max-w-[1200px] px-6 py-20">
      <h2 class="font-heading text-4xl leading-none">Featured projects</h2>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featuredProjects.map((project) => (
          <article class="flex flex-col gap-3">
            <div class="group relative overflow-hidden">
              <Image
                src={project.image}
                alt={project.alt}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                class="aspect-[4/5] w-full object-cover"
              />
              <div class="absolute inset-x-0 bottom-0 translate-y-full bg-black/40 p-6 text-sm text-white/90 opacity-0 backdrop-blur-md transition-all duration-400 ease-out blur-sm group-hover:translate-y-0 group-hover:opacity-100 group-hover:blur-[0px]">
                <p>{project.description}</p>
              </div>
            </div>
            <p class="font-heading font-medium tracking-wide uppercase text-right">
              {project.name}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact call to action -->
  <section id="contact" class="scroll-mt-20 border-t border-border">
    <div class="mx-auto flex w-full max-w-[1200px] flex-col items-center gap-8 px-6 py-24 text-center">
      <h2 class="font-heading text-4xl leading-none">Let's get in touch</h2>
      <p class="font-heading text-4xl leading-none break-all sm:text-6xl">
        ton_contact@gmail.com
      </p>
    </div>
  </section>

  <!-- Contact details -->
  <section>
    <div class="mx-auto grid w-full max-w-[1200px] gap-10 px-6 py-16 md:grid-cols-3">
      {contact.map((block) => (
        <div class="flex flex-col gap-4">
          <h3 class="font-heading text-xl leading-none">{block.title}</h3>
          <div class="flex flex-col gap-1 text-sm text-muted-foreground">
            {block.lines.map((line) => (
              <p>{line}</p>
            ))}
          </div>
          {block.map && (
            <iframe
              src={block.map}
              title={`Map of ${block.title}`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="mt-2 aspect-[4/3] w-full border-0"
            />
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-neutral-950 text-neutral-50">
    <div class="mx-auto flex w-full max-w-[1200px] flex-col gap-12 px-6 py-16 md:flex-row md:items-start md:justify-between">
      <LogoInverted />

      <div class="flex flex-col gap-3 md:items-end">
        <p class="text-xs tracking-widest text-neutral-400 uppercase">
          Quick links
        </p>
        <a href="#" class="text-sm hover:underline">
          Home
        </a>
        <a href="#" class="text-sm hover:underline">
          About Us
        </a>
        <a href="#" class="text-sm hover:underline">
          Projects
        </a>
      </div>
    </div>

    <div class="border-t border-white/10">
      <div class="mx-auto flex w-full max-w-[1200px] flex-col items-center gap-4 px-6 py-6 text-xs text-neutral-400 md:flex-row md:justify-between">
        <p>© 2026 NORTHSTONE CONSTRUCTION & Development, All Rights Reserved</p>
        <div class="flex gap-4">
          <a href="#" class="hover:underline">
            Privacy Policy
          </a>
          <a href="#" class="hover:underline">
            Terms & Conditions
          </a>
          <a href="#" class="hover:underline">
            Cookie Policy
          </a>
        </div>
      </div>
    </div>
  </footer>
</Layout>

<style>
  .hero-line {
    transform-origin: top;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-copy {
    transition:
      opacity 700ms ease-out,
      filter 700ms ease-out,
      transform 700ms ease-out;
    transition-delay: 350ms;
  }

  :global(.js) .hero-line {
    transform: scaleY(0);
  }

  :global(.js) .hero-copy {
    opacity: 0;
    filter: blur(12px);
    transform: translateY(12px);
  }

  .hero-in .hero-line {
    transform: scaleY(1);
  }

  .hero-in .hero-copy {
    opacity: 1;
    filter: blur(0);
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .hero-line,
    :global(.js) .hero-copy {
      opacity: 1;
      filter: none;
      transform: none;
    }

    .hero-line,
    .hero-copy {
      transition: none;
    }
  }
</style>

<script>
  import "@/scripts/hero";
</script>
