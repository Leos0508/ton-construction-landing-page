---
import Layout from '@/layouts/main.astro';
import { Button } from '@/components/ui/button';
---

<Layout
	title="Landing page"
	description="Placeholder landing page built with Astro, Tailwind CSS, and shadcn/ui."
>
	<main
		class="flex min-h-screen flex-col items-center justify-center gap-6 px-6 text-center"
	>
		<p class="font-mono text-xs tracking-[0.2em] text-muted-foreground uppercase">
			Placeholder
		</p>
		<h1 class="max-w-2xl text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
			Your headline goes here
		</h1>
		<p class="max-w-md text-balance text-muted-foreground">
			Astro, Tailwind CSS, and shadcn/ui are wired up. Replace this copy with
			the real pitch.
		</p>
		<div class="flex flex-wrap items-center justify-center gap-3">
			<Button size="lg">Get started</Button>
			<Button variant="outline" size="lg">Learn more</Button>
		</div>
	</main>
</Layout>
